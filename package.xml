<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb4_nav_yolo</name>
  <version>1.0.0</version>
  <description>TurtleBot 4: autonomous waypoint navigation with Nav2 and object detection with YOLO</description>
  <maintainer email="your_email@example.com">Tran Luu Hung</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- ultralytics được cài qua pip: pip install ultralytics -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
